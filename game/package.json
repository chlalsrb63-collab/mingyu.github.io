{
  "name": "higgsfield-game",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run check:logic && tsc --noEmit && bun run scripts/build.mjs",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:logic": "bun run scripts/check-logic.mjs",
    "build:logic": "node scripts/build-logic.mjs",
    "watch:logic": "node scripts/build-logic.mjs --watch",
    "check:split": "node scripts/build-logic.mjs --check",
    "data:check": "node scripts/data-check.mjs",
    "test:rules": "node scripts/test-all.mjs",
    "predev:local": "node scripts/build-logic.mjs",
    "dev:local": "wrangler dev -c wrangler.local.jsonc",
    "predeploy:cf": "node scripts/build-logic.mjs --check && node scripts/test-all.mjs --no-build",
    "deploy:cf": "wrangler deploy -c wrangler.deploy.jsonc",
    "maps:dump": "node scripts/dump-maps.mjs",
    "preview": "node scripts/shot.mjs --serve",
    "shot": "node scripts/shot.mjs",
    "art:export": "node scripts/export-art.mjs",
    "art:gallery": "node scripts/gallery.mjs",
    "art:import": "node scripts/import-art.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260804.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
