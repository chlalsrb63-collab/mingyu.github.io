{
  "$schema": "node_modules/wrangler/config-schema.json",

  // DEPLOY CONFIG for our own Cloudflare account:
  //   npx wrangler deploy -c wrangler.deploy.jsonc
  // (GitHub Actions runs exactly this on every push — see
  // .github/workflows/deploy-game.yml.) Wrangler bundles src/worker.ts itself,
  // and the static client is served straight from ./public.
  "name": "lumentale-online",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": { "HF_ENV": "prod", "APP_SLUG": "lumentale-online" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
