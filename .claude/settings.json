{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git -C .work/codex:*)",
      "Bash(git -C .work/gemini:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(node scripts/:*)",
      "Bash(node game/scripts/:*)",
      "Bash(cd game && npm run:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
