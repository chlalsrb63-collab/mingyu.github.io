{
  // Opening this folder in VS Code starts the AI team (after you allow automatic tasks once):
  // Codex opens in its own terminal and takes its next task from ai/TASKS.md. Gemini is off for now
  // (ai/TEAM.txt); to auto-start it too, add "runOptions": { "runOn": "folderOpen" } to "AI: Gemini".
  // Delete this file if you don't want that.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI: Codex",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "ai\\worker.bat", "codex"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "group": "ai-team", "focus": false },
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      "label": "AI: Gemini",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "ai\\worker.bat", "gemini"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "panel": "dedicated", "group": "ai-team", "focus": false },
      "problemMatcher": []
    },
    {
      "label": "Play the game",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "PLAY.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
